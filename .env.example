# OpenAI-compatible Embedding 服务。不要在此文件填写真实凭证。
EMBEDDING_BASE_URL=https://api.example.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=

# MVP 不固定具体 Embedding 模型；模型和维度由部署配置提供，并以目标
# Endpoint 的实时探针为准。模型变化需要重建向量索引。

# 探针只验证该批量能否成功，不会自动探测服务的最大上限。
EMBEDDING_PROBE_BATCH_SIZE=2
EMBEDDING_TIMEOUT_SECONDS=30

# MVP 固定版本；本地探针默认连接 Compose 暴露的 6333 端口。
QDRANT_IMAGE=qdrant/qdrant:v1.18.2@sha256:75eab8c4ba42096724fdcfde8b4de0b5713d529dde32f285a1f86fdcb2c9e50c
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=shared_knowledge

POSTGRES_IMAGE=postgres:17.10-alpine@sha256:742f40ea20b9ff2ff31db5458d127452988a2164df9e17441e191f3b72252193
POSTGRES_DB=ogx
POSTGRES_USER=ogx
POSTGRES_PASSWORD=ogx-local-only

OGX_HOST_PORT=8321
QDRANT_HOST_PORT=6333

# 默认使用 Debian 官方源；仅在部署网络需要时覆盖。
DEBIAN_MIRROR=http://deb.debian.org/debian
DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security

# 默认使用 uv.lock 中的官方 PyPI 地址；镜像必须提供相同文件，哈希仍按锁文件校验。
PYPI_SIMPLE_URL=https://pypi.org/simple
PYPI_FILES_URL=https://files.pythonhosted.org/packages

# Docling HybridChunker 默认 tokenizer；固定 revision 并在构建时写入镜像。
HF_ENDPOINT=https://huggingface.co
DOCLING_LAYOUT_MODEL_REVISION=8f39ad3c0b4c58e9c2d2c84a38465abf757272d8
DOCLING_TABLE_MODEL_REVISION=fc0f2d45e2218ea24bce5045f58a389aed16dc23
DOCLING_TOKENIZER_MODEL=sentence-transformers/all-MiniLM-L6-v2
DOCLING_TOKENIZER_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
