# 服务间 Token 与租户凭证加密 Master Key。生产环境必须由 Secret 注入。
COMPOSE_PROJECT_NAME=shared-knowledge-service
KNOWLEDGE_RUNTIME_TOKEN=runtime-local-only-change-me
KNOWLEDGE_ADMIN_TOKEN=admin-local-only-change-me
KNOWLEDGE_CREDENTIAL_MASTER_KEY=credential-local-only-change-me

# 租户模型 URL 默认只允许公网 HTTPS。确需 Docker 内网或企业内网时，
# 由部署方显式列出 Host；允许 HTTP 还必须同时加入第二项。
KNOWLEDGE_INFERENCE_ALLOWED_HOSTS=
KNOWLEDGE_INFERENCE_HTTP_ALLOWED_HOSTS=
KNOWLEDGE_INFERENCE_TIMEOUT_SECONDS=30

# 无效原文件由 Knowledge 进程启动时及周期任务自动回收，不新增管理接口。
KNOWLEDGE_FAILED_SOURCE_RETENTION_DAYS=7
KNOWLEDGE_UNCOMMITTED_SOURCE_RETENTION_HOURS=24
KNOWLEDGE_FILE_CLEANUP_INTERVAL_HOURS=24

# 原文件后端二选一。默认使用本地持久卷；切到 remote::s3 时填写下面的 S3 配置。
# S3-compatible 服务可通过 S3_ENDPOINT_URL 指向已有服务，本项目不会额外部署对象存储。
FILES_PROVIDER_TYPE=inline::localfs
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_AUTO_CREATE_BUCKET=false

# Embedding URL、Key、模型与维度不再由环境变量全局固定，改由租户 Admin API 配置。

# Rerank URL、独立 Key、模型和开关同样由租户 Admin API 配置。
RERANK_CANDIDATE_LIMIT=50

# MVP 固定版本；本地探针默认连接 Compose 暴露的 6333 端口。
QDRANT_IMAGE=qdrant/qdrant:v1.18.2@sha256:75eab8c4ba42096724fdcfde8b4de0b5713d529dde32f285a1f86fdcb2c9e50c
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=shared_knowledge

POSTGRES_IMAGE=postgres:17.10-alpine@sha256:742f40ea20b9ff2ff31db5458d127452988a2164df9e17441e191f3b72252193
POSTGRES_DB=ogx
POSTGRES_USER=ogx
POSTGRES_PASSWORD=ogx-local-only

OGX_HOST_PORT=8321
QDRANT_HOST_PORT=6333

# 默认使用国内 Debian 镜像；其他部署网络仍可显式覆盖。
DEBIAN_MIRROR=https://mirrors.aliyun.com/debian
DEBIAN_SECURITY_MIRROR=https://mirrors.aliyun.com/debian-security

# 默认使用国内 PyPI 镜像；镜像必须提供相同文件，哈希仍按锁文件校验。
PYPI_SIMPLE_URL=https://mirrors.aliyun.com/pypi/simple
PYPI_FILES_URL=https://mirrors.aliyun.com/pypi/packages

# Docling HybridChunker 默认 tokenizer；固定 revision 并在构建时写入镜像。
HF_ENDPOINT=https://hf-mirror.com
# 构建脚本仍保留显式回退逻辑，供部署方覆盖为其他首选端点时使用。
HF_FALLBACK_ENDPOINT=https://hf-mirror.com
DOCLING_LAYOUT_MODEL_REVISION=8f39ad3c0b4c58e9c2d2c84a38465abf757272d8
DOCLING_TABLE_MODEL_REVISION=fc0f2d45e2218ea24bce5045f58a389aed16dc23
DOCLING_TOKENIZER_MODEL=sentence-transformers/all-MiniLM-L6-v2
DOCLING_TOKENIZER_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
